# MongoDB connection string
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>/<db>

# Firebase project used for Google sign-in (verifies users' ID tokens)
FIREBASE_PROJECT_ID=internshala-9e300

# Secret used to hash one-time passwords. Use a long random string.
OTP_SECRET=change-me-to-a-long-random-string

# SMTP settings for sending OTP emails.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, and an App Password as SMTP_PASS.
# If SMTP_HOST is empty and NODE_ENV is not "production", OTPs are printed to the server console instead.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="InternArea <no-reply@example.com>"

# Optional OTP tuning
# OTP_TTL_MINUTES=5
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_MAX_REQUESTS_PER_HOUR=5
# OTP_MAX_VERIFY_ATTEMPTS=5

# Razorpay (Resume Builder and Premium payments).
# Get test keys at https://dashboard.razorpay.com/app/keys (Test Mode).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional but recommended: confirms payments even if the student's browser closes.
# Dashboard > Settings > Webhooks: URL https://<your-backend>/api/payments/webhook,
# events payment.captured, payment.failed, order.paid. Use the same secret here.
RAZORPAY_WEBHOOK_SECRET=

# Local demos without Razorpay keys: PAYMENT_MODE=mock shows a simulated
# checkout (Pay / Fail / Cancel) instead of Razorpay. No money is charged.
# Ignored when NODE_ENV=production. Remove it to use real Razorpay.
# PAYMENT_MODE=mock

# Prices in paise (5000 = Rs 50) and Premium length.
# PREMIUM_PRICE_PAISE=5000
# PREMIUM_DURATION_DAYS=90
# RESUME_PRICE_PAISE=5000

# Optional payment tuning
# PAYMENT_VERIFICATION_WINDOW_MINUTES=15
# PAYMENT_ORDER_TTL_MINUTES=30
# PAYMENT_MAX_ORDERS_PER_VERIFICATION=3

# Shown on invoices
# INVOICE_SELLER_NAME=InternArea
# INVOICE_SELLER_ADDRESS=India
# INVOICE_SELLER_EMAIL=
